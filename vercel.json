{
  "framework": "nextjs",
  "buildCommand": "next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/precos",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/arena-sistema",
      "schedule": "*/5 * * * *"
    }
  ],
  "regions": [
    "iad1"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "soubots.com" }],
      "destination": "https://www.soubots.com/:path*",
      "permanent": true
    }
  ]
}
