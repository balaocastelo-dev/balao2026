# ===== Turso (banco de dados gratuito — SQLite/libSQL na nuvem) =====
# Pegue a URL e o token em https://app.turso.tech (no seu banco ou criando um token)
TURSO_DATABASE_URL=libsql://SEU-BANCO-SUA-ORG.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# Senha do painel administrativo (obrigatória — sem ela o painel não abre)
PAINEL_PASSWORD=

# ===== Legado Supabase (apenas durante a transição — pode deixar vazio) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_API_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=balaocastelo@gmail.com
CRON_SECRET=
BLOG_RSS_FEEDS=
BLOG_AGENT_RSS_ENABLED=true
BLOG_AGENT_PRODUCT_ENABLED=true
BLOG_AI_MODEL=gemini-1.5-flash
NEXT_PUBLIC_WHATSAPP_PANEL_SERVER_URL=http://localhost:4100
WHATSAPP_PANEL_ALLOWED_ORIGIN=http://localhost:3000
WHATSAPP_PANEL_PORT=4100

# ===== Acesso dos vendedores (paginas pessoais, ex.: /brendon) =====
# Todos atendem pelo MESMO numero da loja (5519987510267). O WhatsApp e
# conectado uma unica vez por QR Code em /crm; cada vendedor entra na sua
# pagina com a propria senha, no proprio PC.
#
# OBRIGATORIAS. As senhas NAO ficam no codigo porque este repositorio e
# publico — senha versionada vira senha publica, e o historico do git nao
# esquece. Sem a variavel definida na hospedagem o acesso daquele vendedor
# fica fechado, e a tela de login avisa qual variavel falta.
#
# Uma por pessoa. O nome segue o slug da pagina: /julia -> VENDEDOR_JULIA_SENHA
VENDEDOR_THIAGO_SENHA=
VENDEDOR_MARCOS_SENHA=
VENDEDOR_JULIA_SENHA=
VENDEDOR_GABRIEL_SENHA=
VENDEDOR_WENDELL_SENHA=
VENDEDOR_BRENDON_SENHA=

# ===== Servidor de WhatsApp: onde guardar os dados =====
# Junta a sessao do WhatsApp (.wwebjs_auth) e a pasta data/ (etiquetas,
# kanban de cada vendedor, notas de cliente e midia) embaixo de um caminho
# so, para um unico volume/disco dar conta em container.
# Vazio = tudo fica ao lado do codigo, como antes.
DATA_ROOT=

# Faxina da pasta de midia (ver docs/hospedar-whatsapp-server.md)
MEDIA_RETENCAO_DIAS=60
MEDIA_LIMITE_MB=20000
MEDIA_LIMPEZA_HORAS=6
