# ===== Turso (banco de dados gratuito — SQLite/libSQL na nuvem) =====
# Pegue a URL e o token em https://app.turso.tech (no seu banco ou criando um token)
TURSO_DATABASE_URL=libsql://SEU-BANCO-SUA-ORG.turso.io
TURSO_AUTH_TOKEN=seu-token-aqui

# Senha do painel administrativo (obrigatória — sem ela o painel não abre)
PAINEL_PASSWORD=

# ===== Legado Supabase (apenas durante a transição — pode deixar vazio) =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_API_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=balaocastelo@gmail.com
CRON_SECRET=
BLOG_RSS_FEEDS=
BLOG_AGENT_RSS_ENABLED=true
BLOG_AGENT_PRODUCT_ENABLED=true
BLOG_AI_MODEL=gemini-1.5-flash
NEXT_PUBLIC_WHATSAPP_PANEL_SERVER_URL=http://localhost:4100
WHATSAPP_PANEL_ALLOWED_ORIGIN=http://localhost:3000
WHATSAPP_PANEL_PORT=4100
