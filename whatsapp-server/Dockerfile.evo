# Servidor do painel de WhatsApp sobre a Evolution API.
# Sem Chromium: quem fala com o WhatsApp é o container da Evolution.
FROM node:20-bookworm-slim

ENV NODE_ENV=production \
    TZ=America/Sao_Paulo

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates tzdata fonts-dejavu-core fontconfig \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY evo/package.json evo/package-lock.json ./
# npm às vezes "termina" sem instalar nada quando a rede falha (bug do
# próprio npm). A checagem abaixo faz o build parar em vez de subir quebrado.
RUN npm ci --omit=dev \
 && node -e "require('express'); require('socket.io'); require('pg'); require('sharp')" \
 || (echo "ERRO: npm nao instalou as dependencias" >&2 && exit 1)

# ATENÇÃO: esta lista é arquivo por arquivo. Módulo novo na raiz do servidor
# TEM de ser acrescentado aqui — senão o container sobe, o require falha e o
# servidor morre no boot, com o painel em 502. Foi o que aconteceu em 02/10:
# o vigia.js foi criado, testado, deployado... e não estava dentro da imagem.
COPY servidor.js catalogo.js vigia.js vendedores-fixos.json confere-imagem.js ./
COPY evo ./evo
COPY status ./status
COPY crm ./crm

# A rede de segurança para o erro acima: confere que todo require("./...") de
# todo arquivo copiado resolve de verdade. Se faltar um, o BUILD falha aqui — e
# o deploy nem chega a trocar o container, então o servidor antigo continua
# atendendo. Build vermelho em vez de painel em 502.
RUN node confere-imagem.js

ARG VERSAO=dev
RUN echo "$VERSAO" > VERSAO

EXPOSE 4100
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "servidor.js"]
